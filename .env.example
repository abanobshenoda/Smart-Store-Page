# Smart Store - Environment Variables
# Copy to .env.local and fill in real values

DATABASE_URL=postgresql://user:pass@localhost:5432/smart_store
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here
DATABASE_URL_UNPOOLED=postgresql://user:pass@localhost:5432/smart_store
NEON_BRANCH=production
